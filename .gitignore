# Literature inventory is reference material and is intentionally kept outside
# the outer research repository's Git history.
/literature/

# data: payloads (raw downloads, LFS clones, corpora, indexes) stay out of
# Git; download scripts and directory structure are tracked via the ! rules.
data/*
data/**/*
!data/**/
!data/**/*.sh
!data/**/.gitkeep
# Embedded Git LFS clones under raw/ — keep them out (gitlinks would be added).
data/**/raw/
# Local test fixture — stays on disk, never tracked.
data/wiki-demo/

# Local Python tooling.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/

# Linters / static analysis caches.
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Local agent evaluation credentials and overrides.
.agent/*


# macOS
.DS_Store

# IDE
.vscode/
